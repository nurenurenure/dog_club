# Copy to .env, replace the placeholder in BOTH values, then export via README.
# Use a URI-safe password here (for example, 32 random hexadecimal characters).
POSTGRES_USER=dogclub
POSTGRES_DB=dogclub
POSTGRES_PASSWORD=replace_with_random_hex_password
POSTGRES_PORT=5432
DATABASE_URL=postgres://dogclub:replace_with_random_hex_password@127.0.0.1:5432/dogclub?sslmode=disable

HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=info
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
DB_PING_TIMEOUT=1s
SHUTDOWN_TIMEOUT=10s

# Generate once using: openssl rand -base64 32
AUTH_JWT_KEY=replace_with_random_base64_key
AUTH_JWT_ISSUER=dogclub.local
AUTH_JWT_AUDIENCE=dogclub-api
AUTH_IO_TIMEOUT=10s
# Development HTTP is allowed only on a loopback HTTP_ADDR.
AUTH_COOKIE_SECURE=false
SMTP_ADDR=127.0.0.1:1025
MAIL_FROM=noreply@dogclub.test
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
